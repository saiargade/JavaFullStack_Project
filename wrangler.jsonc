{
  "name": "pashufeed-pro",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "backend/server/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "d1_databases": [
    { "binding": "DB", "database_id": "00000000-0000-0000-0000-000000000000" }
  ]
}